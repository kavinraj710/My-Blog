@page "/"

<PageTitle>Home</PageTitle>

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f7f7f7;
        color: #333;
        margin: 0;
        padding: 0;
    }

    .container {
        width: 85%;
        margin: 0 auto;
        padding: 20px;
    }

    header {
        text-align: center;
        margin-bottom: 40px;
    }

    h1 {
        font-size: 48px;
        color: #2c3e50;
    }

    p {
        font-size: 18px;
        color: #7f8c8d;
        line-height: 1.6;
    }

    .hero {
        background-color: #2980b9;
        color: #fff;
        padding: 60px 20px;
        text-align: center;
        border-radius: 8px;
        margin-bottom: 40px;
    }

        .hero h2 {
            font-size: 36px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 20px;
            max-width: 600px;
            margin: 0 auto;
        }

    .post-list {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-top: 40px;
    }

    .post-card {
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        width: 30%;
    }

        .post-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 8px;
        }

        .post-card h3 {
            font-size: 24px;
            color: #2980b9;
            margin-top: 15px;
        }

        .post-card p {
            font-size: 16px;
            color: #7f8c8d;
            margin-top: 10px;
        }

    .cta {
        background-color: #2c3e50;
        color: #fff;
        padding: 30px;
        text-align: center;
        border-radius: 8px;
        margin-top: 60px;
    }

        .cta h2 {
            font-size: 28px;
        }

        .cta p {
            font-size: 18px;
        }

        .cta a {
            color: #fff;
            font-weight: bold;
            text-decoration: none;
            background-color: #e67e22;
            padding: 10px 25px;
            border-radius: 5px;
            margin-top: 15px;
            display: inline-block;
        }

            .cta a:hover {
                background-color: #d35400;
            }

    footer {
        text-align: center;
        padding: 20px;
        background-color: #ecf0f1;
        margin-top: 50px;
    }
</style>

<div class="container">
    <!-- Hero Section -->
    <header>
        <h1>Welcome to Our Blog</h1>
        <p>Your daily source of insights, stories, and tips on blogging, personal growth, and more. Let's inspire each other!</p>
    </header>

    <section class="hero">
        <h2>Stay Ahead with the Latest Trends and Tips</h2>
        <p>Explore expertly written articles covering everything from content creation to marketing strategies. Whether you're a beginner or an experienced blogger, we've got something for everyone!</p>
    </section>

    <!-- Recent Posts Section -->
    <section>
        <h2>Recent Posts</h2>
        <div class="post-list">
            <div class="post-card">
                <img src="blog1.jpg" alt="How to Get Started with Blogging">
                <h3><a href="/post/1">How to Get Started with Blogging</a></h3>
                <p>If you're thinking about starting your own blog, this post is a must-read! Learn how to pick the right platform, choose your niche, and write your first post.</p>
            </div>

            <div class="post-card">
                <img src="bloglogo.png" alt="The Best Tools for Content Creation">
                <h3><a href="/post/2">The Best Tools for Content Creation</a></h3>
                <p>Creating high-quality content has never been easier. Discover the top tools that will make writing, editing, and designing content a breeze.</p>
            </div>

            <div class="post-card">
                <img src="blog2.jpg" alt="Top 5 Tips for Growing Your Blog Audience">
                <h3><a href="/post/3">Top 5 Tips for Growing Your Blog Audience</a></h3>
                <p>Struggling to gain traction with your blog? These 5 tips will help you grow your audience and boost traffic to your site.</p>
            </div>
        </div>
    </section>
    <p></p>
    <!-- Featured Blog Section -->
    <section>
        <h2>Featured Blog: Mastering SEO for Your Blog</h2>
        <div>
            <p>Search Engine Optimization (SEO) is one of the most important skills you can learn as a blogger. Our featured article dives into effective SEO strategies that will boost your blog's visibility on search engines and attract more readers.</p>
            <p><a href="/post/seo-tips">Read the full guide on mastering SEO</a></p>
        </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="cta">
        <h2>Don't Miss Out on the Latest Articles!</h2>
        <p>Stay tuned for fresh content! Bookmark this page and be sure to visit us often for the latest posts and expert tips on blogging.</p>
    </section>
</div>

<footer>
    <p>&copy; 2025 Our Blog. All Rights Reserved.</p>
</footer>
